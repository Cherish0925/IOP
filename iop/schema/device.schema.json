{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Instrument",
  "type": "object",
  "required": [
    "driver"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "description": "Optional. The service generates a stable ID when omitted."
    },
    "driver": {
      "type": "string",
      "minLength": 1,
      "description": "An installed adapter name or Python module:Class. Read /v1/adapters."
    },
    "config": {
      "type": "object",
      "description": "Driver-specific connection settings and named operations.",
      "properties": {
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "$ref": "#/$defs/parameter"
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Operation name patterns available on this instrument, such as read_* or set.ch1.*; identify stays available. Omit to allow all."
    },
    "limits": {
      "type": "object",
      "description": "Bounds this setup tolerates on the numeric arguments of operations, within what the instrument accepts, such as {\"set_current\": {\"current\": {\"maximum\": 0.05, \"note\": \"The diode is damaged above 50 mA\"}}}. Arguments beyond them are refused before the instrument is called, with the note; the description shows them.",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "note": {
              "type": "string",
              "description": "Why, shown when an argument is refused"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "process"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum operation duration in seconds; default 300."
        },
        "startup_timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Driver startup and description timeout in seconds; default 30."
        },
        "cancel_timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Time to finish cancellation before the SDK process ends; default 2."
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": [
        "id"
      ],
      "description": "Calibration of this instrument. Operations record its id and any uncertainty listed for them.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Certificate or calibration record identifier"
        },
        "date": {
          "type": "string",
          "description": "ISO date or time with offset"
        },
        "valid_until": {
          "type": "string",
          "description": "ISO date (ends 23:59:59 UTC) or time with offset"
        },
        "certificate": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "enforce": {
          "type": "boolean",
          "description": "Refuse new operations after valid_until"
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "Operation name to uncertainty, for example {\"value\": 0.02, \"unit\": \"V\", \"coverage_factor\": 2}"
        }
      }
    },
    "monitors": {
      "type": "array",
      "description": "Periodic reads of an observe operation while the device is idle; see docs/runtime/drivers.md",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "interval_s"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "operation": {
            "type": "string",
            "description": "An operation described with effect observe"
          },
          "arguments": {
            "type": "object"
          },
          "interval_s": {
            "type": "number",
            "minimum": 0.1
          },
          "value": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            },
            "description": "Path to the value in the result; default [\"value\"]"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "equals": {},
          "on_violation": {
            "enum": [
              "record",
              "hold"
            ]
          },
          "hold": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Other devices or shared resources held with this device"
          }
        }
      }
    },
    "instrument_profile": {
      "type": "string",
      "description": "ID of a model description in /v1/instrument-catalog. Its operations, name and documentation are added at registration; operations in config take precedence."
    },
    "conditions": {
      "type": "array",
      "description": "What must hold for this instrument's readings to mean something, observed and restored with its own operations. Named <device>.<id> in the laboratory; platform conditions may depend on them.",
      "items": {
        "$ref": "#/$defs/instrumentCondition"
      }
    }
  },
  "$defs": {
    "instrumentStep": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "One operation of this instrument; device may be omitted.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "instrumentTolerance": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "minimum"
          ]
        },
        {
          "required": [
            "maximum"
          ]
        },
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "target"
          ]
        },
        {
          "required": [
            "bits"
          ]
        }
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into the observation result; default [\"value\"]."
        },
        "minimum": {
          "description": "A number in the unit of the reading, or a quantity with its unit such as \"20 mK\" when the reading's unit is described.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        },
        "maximum": {
          "description": "A number in the unit of the reading, or a quantity with its unit such as \"20 mK\" when the reading's unit is described.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        },
        "equals": {},
        "statistic": {
          "enum": [
            "mean",
            "std",
            "span",
            "slope"
          ],
          "description": "With samples: judge the mean (default), the standard deviation, the span or the slope per second of the readings."
        },
        "target": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "description": "A quantity with its unit, such as \"-253.15 °C\""
            },
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "$ref": "#/$defs/instrumentTarget"
            }
          ],
          "description": "A nominal or certified value, or the reading that gives it, such as the setpoint the instrument holds. The value judged is the deviation from it."
        },
        "within": {
          "description": "With target: the absolute tolerance of the deviation.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        },
        "relative": {
          "description": "With target: the tolerance as a fraction of the target; added to within.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        },
        "bits": {
          "type": "integer",
          "minimum": 1,
          "description": "A status register: met while none of these bits is set in the reading."
        }
      }
    },
    "instrumentCondition": {
      "type": "object",
      "required": [
        "id",
        "description",
        "verify",
        "accept"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9{][A-Za-z0-9_{}-]{0,47}$",
          "description": "Local name; the laboratory name is <device>.<id>. With each, it names every {name} it uses."
        },
        "each": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100
          },
          "description": "Write the condition once for several channels, inputs, outputs or axes: {\"channel\": [\"CH1\", \"CH2\"]} makes one condition for each value; \"{channel}\" in the id, description, note, after and arguments is replaced by it."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "An extensible label such as equilibrium, reference, calibration, lock or operating_point."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Local names of this instrument's conditions that must hold first."
        },
        "verify": {
          "$ref": "#/$defs/instrumentStep"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1,
          "description": "Readings one verification takes; a tolerance judges their statistic."
        },
        "interval": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Seconds between samples."
        },
        "accept": {
          "$ref": "#/$defs/instrumentTolerance"
        },
        "usable": {
          "$ref": "#/$defs/instrumentTolerance",
          "description": "Every sample must pass unless statistic explicitly selects an aggregate."
        },
        "reference": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "correct": {
          "description": "Operations of this instrument that restore the condition, tried in order; tune is accepted as on platforms.",
          "oneOf": [
            {
              "$ref": "#/$defs/instrumentStep"
            },
            {
              "type": "object",
              "required": [
                "tune"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          ]
        },
        "settle": {
          "type": "number",
          "minimum": 0
        },
        "valid_for": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parameter contract for a new local definition. Omit type for an unconstrained JSON value; x-* annotations do not impose constraints.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "type": {
          "enum": [
            "number",
            "integer",
            "string",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "items": {
          "$ref": "#/$defs/parameter"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "limit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "examples": {
          "type": "array"
        }
      },
      "dependentSchemas": {
        "minimum": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            }
          }
        },
        "maximum": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            }
          }
        },
        "items": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        },
        "minItems": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        },
        "maxItems": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        }
      }
    },
    "instrumentTarget": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "The reading of this instrument that gives a target, such as its setpoint; device may be omitted.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into its result; default [\"value\"]."
        }
      }
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
