{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Workflow",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "platform_revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/strings"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "description": "Device whose operation is called (a Basic Operation). Omit it to use a saved Standard or Workflow Operation named by operation."
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "after": {
            "$ref": "#/$defs/strings"
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/source"
            }
          },
          "sweep": {
            "$ref": "#/$defs/sweep"
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Platform conditions that must hold for the experiment to be accepted."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "description": "A value an earlier step returned: path selects inside its result or, with view, inside a view of an array it returned",
      "required": [
        "step"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "view": {
      "type": "object",
      "description": "Read the value from a view of an array the step returned: field, along, at, start, stop, low, high, points, peak; path then selects inside the view. Along two axes, a map, along names both and the others give one value per axis. peak max, or min for a dip, finds the line: path [\"peak\", \"center\"] or [\"peak\", \"width\"] (see docs/runtime/drivers.md, Reading arrays)",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "along": {
          "type": [
            "string",
            "integer",
            "array"
          ],
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "at": {
          "type": "object"
        },
        "start": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 0,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "stop": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 1,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "low": {
          "type": [
            "number",
            "array"
          ],
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "high": {
          "type": [
            "number",
            "array"
          ],
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "points": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 1,
          "maximum": 2000,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "peak": {
          "enum": [
            "max",
            "min"
          ]
        }
      }
    },
    "sweep": {
      "type": "object",
      "minProperties": 1,
      "description": "Run this step at each value of these parameters, one point after another, the first changing slowest; what it returns is gathered into arrays over the sweep, at most 10000 points. A list gives the values (numbers, or strings as labels); start, stop and points, or center, span and points, give evenly spaced numbers. An end of a range may be read from an earlier step, as a binding is, such as where a coarse sweep found most power; each point then takes its value when it runs",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          {
            "type": "object",
            "required": [
              "start",
              "stop",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "$ref": "#/$defs/end"
              },
              "stop": {
                "$ref": "#/$defs/end"
              },
              "points": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "center",
              "span",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "center": {
                "$ref": "#/$defs/end"
              },
              "span": {
                "$ref": "#/$defs/end"
              },
              "points": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "end": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    }
  }
}
