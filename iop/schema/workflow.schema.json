{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Workflow",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "platform_revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/strings"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "description": "Device whose operation is called (a Basic Operation). Omit it to use a saved Standard or Workflow Operation named by operation."
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "after": {
            "$ref": "#/$defs/strings"
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "step"
              ],
              "properties": {
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "view": {
                  "type": "object",
                  "description": "Read the value from a view of an array this step returned: field, along, at, start, stop, low, high, points; path then selects inside the view (see docs/runtime/drivers.md, Reading arrays)",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "along": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "at": {
                      "type": "object"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stop": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Platform conditions that must hold for the experiment to be accepted."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
