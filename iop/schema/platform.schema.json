{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Platform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "devices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "devices": {
      "$ref": "#/$defs/strings"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "devices"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "devices": {
            "allOf": [
              {
                "$ref": "#/$defs/strings"
              },
              {
                "minItems": 1
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "signal": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "Electrical timing of a trigger, gate, marker, clock, reference or sync connection. Hardware performs the timing; the description records it.",
            "properties": {
              "type": {
                "enum": [
                  "trigger",
                  "gate",
                  "marker",
                  "clock",
                  "reference",
                  "sync"
                ]
              },
              "edge": {
                "enum": [
                  "rising",
                  "falling",
                  "both"
                ]
              },
              "delay_s": {
                "type": "number"
              },
              "width_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "level_v": {
                "type": "number"
              },
              "frequency_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "impedance_ohm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "procedures": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "operation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "device": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Device whose operation is called (a Basic Operation). Omit it to use a saved Standard or Workflow Operation named by operation."
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                },
                "after": {
                  "$ref": "#/$defs/strings"
                },
                "resources": {
                  "$ref": "#/$defs/strings"
                },
                "requirements": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "bindings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "step"
                    ],
                    "properties": {
                      "step": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "description": "What must hold on the platform for its experiments. The Runtime verifies each condition, corrects it when it drifted and trusts an accepted verification for valid_for.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "verify",
          "accept"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "description": "Unique among all platforms."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "environment",
              "equilibrium",
              "reference",
              "calibration",
              "alignment",
              "lock",
              "operating_point",
              "signal"
            ],
            "description": "From the outside in; each kind presupposes the ones before it."
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Conditions of this platform that must hold first."
          },
          "verify": {
            "$ref": "#/$defs/conditionStep"
          },
          "accept": {
            "$ref": "#/$defs/tolerance"
          },
          "usable": {
            "$ref": "#/$defs/tolerance",
            "description": "When not met, the measurement itself means nothing and the conditions in after are verified."
          },
          "reference": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "description": "Values of the accepted verification kept with experiments that rely on the condition."
          },
          "correct": {
            "oneOf": [
              {
                "$ref": "#/$defs/conditionStep"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/conditionStep"
                }
              }
            ],
            "description": "Operations that restore the condition, tried in order; each is followed by a verification."
          },
          "settle": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds between a correction and its verification."
          },
          "valid_for": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Seconds an accepted verification is trusted."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conditionStep": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "One operation: a device operation, or a saved operation without device.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "minimum"
          ]
        },
        {
          "required": [
            "maximum"
          ]
        },
        {
          "required": [
            "equals"
          ]
        }
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into the verification result; default [\"value\"]."
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "equals": {}
      }
    }
  }
}
