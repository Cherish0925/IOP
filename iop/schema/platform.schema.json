{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Platform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "devices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "devices": {
      "$ref": "#/$defs/strings"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "devices"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "devices": {
            "allOf": [
              {
                "$ref": "#/$defs/strings"
              },
              {
                "minItems": 1
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "signal": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "Electrical timing of a trigger, gate, marker, clock, reference or sync connection. Hardware performs the timing; the description records it.",
            "properties": {
              "type": {
                "enum": [
                  "trigger",
                  "gate",
                  "marker",
                  "clock",
                  "reference",
                  "sync"
                ]
              },
              "edge": {
                "enum": [
                  "rising",
                  "falling",
                  "both"
                ]
              },
              "delay_s": {
                "type": "number"
              },
              "width_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "level_v": {
                "type": "number"
              },
              "frequency_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "impedance_ohm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "procedures": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "operation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "device": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Device whose operation is called (a Basic Operation). Omit it to use a saved Standard or Workflow Operation named by operation."
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                },
                "after": {
                  "$ref": "#/$defs/strings"
                },
                "resources": {
                  "$ref": "#/$defs/strings"
                },
                "requirements": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "bindings": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/source"
                  }
                },
                "sweep": {
                  "$ref": "#/$defs/sweep"
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "description": "Run the step this many times in turn, at each point of its sweep if it has one; what it returns is gathered over a last axis named repeat"
                },
                "until": {
                  "$ref": "#/$defs/until"
                }
              }
            }
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "description": "What must hold on the platform for its experiments. The Runtime verifies each condition, corrects it when it drifted and trusts an accepted verification for valid_for.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "verify",
          "accept"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "description": "Unique among all platforms."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "description": "Optional, extensible category. Dependencies are defined only by after."
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Conditions of this platform that must hold first."
          },
          "verify": {
            "$ref": "#/$defs/conditionStep"
          },
          "accept": {
            "$ref": "#/$defs/tolerance"
          },
          "usable": {
            "$ref": "#/$defs/tolerance",
            "description": "When not met, the measurement itself means nothing and the conditions in after are verified."
          },
          "reference": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "description": "Values of the accepted verification kept with experiments that rely on the condition."
          },
          "correct": {
            "oneOf": [
              {
                "$ref": "#/$defs/conditionStep"
              },
              {
                "$ref": "#/$defs/conditionTuning"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/conditionStep"
                    },
                    {
                      "$ref": "#/$defs/conditionTuning"
                    }
                  ]
                }
              }
            ],
            "description": "What restores the condition, tried in order; each is followed by a verification. An operation, or tune."
          },
          "settle": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds between a correction and its verification."
          },
          "valid_for": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Seconds an accepted verification is trusted."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "upkeep": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared, the Runtime keeps the platform's conditions: while the instruments a pass needs are idle, it starts a pass for conditions that are unknown, due, lost, about to expire or forecast to leave their tolerance. Each automatic pass is recorded with automatic: true and its reasons, and never runs a step that asks a person.",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Conditions to keep; default all of the platform's and its instruments'."
        },
        "ahead_s": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Observe this long before validity ends or the drift forecast reaches the tolerance."
        },
        "retry_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1800,
          "description": "Wait before another attempt at a condition the last attempt did not bring to hold."
        },
        "correct": {
          "type": "boolean",
          "default": true,
          "description": "false: observe and record only; nothing is corrected."
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conditionStep": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "One operation: a device operation, or a saved operation without device.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "minimum"
          ]
        },
        {
          "required": [
            "maximum"
          ]
        },
        {
          "required": [
            "equals"
          ]
        }
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into the verification result; default [\"value\"]."
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "equals": {}
      }
    },
    "conditionTuning": {
      "type": "object",
      "required": [
        "tune"
      ],
      "additionalProperties": false,
      "description": "A correction the Runtime performs itself: it adjusts the settings one at a time against the verification value, steps back from a setting that does not improve it, and halves the step when no move helps.",
      "properties": {
        "tune": {
          "description": "One setting, or several adjusted jointly.",
          "oneOf": [
            {
              "$ref": "#/$defs/tunedSetting"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/tunedSetting"
              }
            }
          ]
        },
        "goal": {
          "enum": [
            "maximize",
            "minimize",
            "center"
          ],
          "description": "Default: maximize with only a minimum in accept, minimize with only a maximum, center with both."
        },
        "evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 40,
          "description": "Settings that may be tried."
        },
        "until": {
          "enum": [
            "optimum",
            "accept"
          ],
          "default": "optimum",
          "description": "accept stops once the tolerance is met."
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Smallest improvement that counts, above the noise of the verification."
        }
      }
    },
    "tunedSetting": {
      "type": "object",
      "required": [
        "device",
        "operation",
        "argument",
        "read",
        "step",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "description": "The operation that sets the value."
        },
        "argument": {
          "type": "string",
          "minLength": 1,
          "description": "Its argument that is adjusted."
        },
        "arguments": {
          "type": "object",
          "description": "Other, fixed arguments of that operation."
        },
        "read": {
          "type": "object",
          "required": [
            "device",
            "operation"
          ],
          "additionalProperties": false,
          "description": "The operation that returns the present setting.",
          "properties": {
            "device": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            },
            "value": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          }
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "First step size."
        },
        "resolution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Smallest step worth taking; default step / 16."
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number",
          "description": "The search never leaves [minimum, maximum]."
        }
      }
    },
    "source": {
      "type": "object",
      "description": "A value an earlier step returned: path selects inside its result or, with view, inside a view of an array it returned",
      "required": [
        "step"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        }
      }
    },
    "view": {
      "type": "object",
      "description": "Read the value from a view of an array the step returned: field, along, at, start, stop, low, high, points, peak; path then selects inside the view. Along two axes, a map, along names both and the others give one value per axis. peak max, or min for a dip, finds the line: path [\"peak\", \"center\"] or [\"peak\", \"width\"]; level finds where the trace crosses a value: path [\"crossings\", 0, \"at\"]; fit line gives the straight line through it: path [\"fit\", \"slope\"] or [\"fit\", \"zero\"]; fit lorentzian or gaussian a line of that shape: path [\"fit\", \"center\"] or [\"fit\", \"width\"]. With one other axis not fixed, these are read at each of its positions: path [\"rows\", \"peak\", 0, \"center\"] (see docs/runtime/drivers.md, Reading arrays)",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "along": {
          "type": [
            "string",
            "integer",
            "array"
          ],
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "at": {
          "type": "object"
        },
        "start": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 0,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "stop": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 1,
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "low": {
          "type": [
            "number",
            "array"
          ],
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "high": {
          "type": [
            "number",
            "array"
          ],
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "points": {
          "type": [
            "integer",
            "array"
          ],
          "minimum": 1,
          "maximum": 2000,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "peak": {
          "enum": [
            "max",
            "min"
          ]
        },
        "prominence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "With peak, read every line that stands out by this much: path [\"peaks\"]"
        },
        "level": {
          "type": "number",
          "description": "Read where the trace crosses this value, between samples, rising or falling"
        },
        "fit": {
          "enum": [
            "line",
            "lorentzian",
            "gaussian"
          ],
          "description": "Fit a straight line, or a line of Lorentzian or Gaussian shape, through the trace by least squares"
        }
      }
    },
    "sweep": {
      "type": "object",
      "minProperties": 1,
      "description": "Run this step at each value of these parameters, one point after another, the first changing slowest; what it returns is gathered into arrays over the sweep, at most 10000 points. A list gives the values (numbers, or strings as labels); start, stop and points, or center, span and points, give evenly spaced numbers. An end of a range may be read from an earlier step, as a binding is, such as where a coarse sweep found most power; each point then takes its value when it runs. With adapt, each point is placed from what the earlier ones read, closer together where the reading changes most",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          {
            "type": "object",
            "required": [
              "start",
              "stop",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "$ref": "#/$defs/end"
              },
              "stop": {
                "$ref": "#/$defs/end"
              },
              "points": {
                "type": "integer",
                "minimum": 1
              },
              "adapt": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "description": "Place each point from what the earlier ones read: the path to the number each point reads, such as [\"power\"]; points come closer where it changes most (one swept parameter, 2 to 1000 points, gathered in order of value)"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "center",
              "span",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "center": {
                "$ref": "#/$defs/end"
              },
              "span": {
                "$ref": "#/$defs/end"
              },
              "points": {
                "type": "integer",
                "minimum": 1
              },
              "adapt": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "description": "Place each point from what the earlier ones read: the path to the number each point reads, such as [\"power\"]; points come closer where it changes most (one swept parameter, 2 to 1000 points, gathered in order of value)"
              }
            }
          }
        ]
      }
    },
    "until": {
      "type": "object",
      "required": [
        "path"
      ],
      "minProperties": 2,
      "additionalProperties": false,
      "description": "Stop a sweep or repetition after a point whose reading is above or below a limit, or is not a number: the later points are skipped without reaching an instrument, and the steps after the sweep run. The first point always runs",
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "The number each point reads, in what its operation returns or in the named result of its use, such as [\"current\"]"
        },
        "above": {
          "type": "number",
          "description": "Stop after a point that reads more than this"
        },
        "below": {
          "type": "number",
          "description": "Stop after a point that reads less than this; with above, the sweep goes on while the reading stays between them"
        }
      }
    },
    "end": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    }
  }
}
