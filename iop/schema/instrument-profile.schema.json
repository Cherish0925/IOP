{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Instrument Model Description",
  "type": "object",
  "required": [
    "id",
    "match",
    "config"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "driver": {
      "enum": [
        "scpi",
        "modbus",
        "http"
      ],
      "default": "scpi",
      "description": "Driver whose operations the description holds. SDK drivers describe their own operations."
    },
    "match": {
      "type": "object",
      "required": [
        "manufacturer",
        "model"
      ],
      "properties": {
        "manufacturer": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "serial_number": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "firmware": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "config": {
      "type": "object",
      "required": [
        "operations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "$ref": "#/$defs/parameter"
                }
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "write": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "object",
                "description": "scpi: type (number, integer, boolean, string or array), unit, match, scale, offset, map; any adapter: minimum and maximum of the measuring interval, saturation where the instrument clips"
              },
              "quality": {
                "type": "object",
                "additionalProperties": false,
                "description": "The status read after this reading: scpi query, or another observe operation of the instrument with arguments (\"{parameter}\" passes the reading's argument) and value, its path; a reply other than equals, or with any of bits set, marks the reading uncertain",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equals": {},
                  "bits": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "arguments": {
                    "type": "object"
                  },
                  "value": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    }
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "query"
                    ]
                  },
                  {
                    "required": [
                      "operation"
                    ]
                  }
                ]
              },
              "data": {
                "type": "object",
                "required": [
                  "parameter",
                  "dtype"
                ],
                "description": "Binary block sent after the write command; see docs/runtime/drivers.md",
                "properties": {
                  "parameter": {
                    "type": "string"
                  },
                  "dtype": {
                    "enum": [
                      "int8",
                      "uint8",
                      "int16",
                      "uint16",
                      "int32",
                      "uint32",
                      "int64",
                      "uint64",
                      "float32",
                      "float64"
                    ]
                  },
                  "byte_order": {
                    "enum": [
                      "little",
                      "big"
                    ]
                  }
                }
              },
              "effect": {
                "enum": [
                  "observe",
                  "change"
                ]
              },
              "completion": {
                "type": "object",
                "description": "scpi: query with equals or match, interval and timeout"
              },
              "function": {
                "enum": [
                  "read_holding_registers",
                  "read_input_registers",
                  "read_coils",
                  "read_discrete_inputs",
                  "write_register",
                  "write_registers",
                  "write_coil"
                ]
              },
              "arguments": {
                "type": "object"
              },
              "value_parameter": {
                "type": "string"
              },
              "scale": {
                "type": "number"
              },
              "offset": {
                "type": "number"
              },
              "signed": {
                "type": "boolean"
              },
              "unit": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "body": {},
              "result_path": {
                "type": "array"
              },
              "reply": {
                "description": "scpi write: true, false or {\"match\": pattern} for its acknowledgment line"
              },
              "type": {
                "enum": [
                  "uint16",
                  "int16",
                  "uint32",
                  "int32",
                  "float32",
                  "uint64",
                  "int64",
                  "float64"
                ],
                "description": "modbus: how the value is held in registers; default uint16"
              },
              "word_order": {
                "enum": [
                  "big",
                  "little"
                ],
                "description": "modbus: order of the registers of one value; default big (high word first)"
              },
              "byte_order": {
                "enum": [
                  "big",
                  "little"
                ],
                "description": "modbus: order of the two bytes within a register; default big"
              }
            },
            "description": "scpi: exactly one of query or write. modbus: function, with fixed arguments, type, word_order, byte_order, scale, offset, unit and value_parameter. http: path, method, query, body, result_path and unit."
          }
        },
        "protocol": {
          "type": "object",
          "description": "scpi: traits of a text command language that is not SCPI; see docs/runtime/drivers.md",
          "properties": {
            "read_termination": {
              "type": "string",
              "minLength": 1
            },
            "write_termination": {
              "type": "string",
              "minLength": 1
            },
            "identify": {
              "type": "boolean",
              "description": "false: the instrument has no *IDN? query"
            },
            "error_reply": {
              "type": "string",
              "description": "Pattern of replies that report an error"
            },
            "write_reply": {
              "description": "true or {\"match\": pattern}: every write is answered with one line"
            },
            "echo": {
              "type": "boolean"
            },
            "min_interval": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "description": "What must hold for this instrument's readings to mean something, observed and restored with its own operations. Named <device>.<id> in the laboratory; platform conditions may depend on them. Added to each matching instrument unless its record defines the same name.",
      "items": {
        "$ref": "#/$defs/instrumentCondition"
      }
    }
  },
  "$defs": {
    "instrumentStep": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "One operation of this instrument; device may be omitted.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "instrumentTolerance": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "minimum"
          ]
        },
        {
          "required": [
            "maximum"
          ]
        },
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "target"
          ]
        }
      ],
      "properties": {
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into the observation result; default [\"value\"]."
        },
        "minimum": {
          "type": [
            "number",
            "string"
          ],
          "description": "A number in the unit of the reading, or a quantity with its unit such as \"20 mK\" when the reading's unit is described."
        },
        "maximum": {
          "type": [
            "number",
            "string"
          ],
          "description": "A number in the unit of the reading, or a quantity with its unit such as \"20 mK\" when the reading's unit is described."
        },
        "equals": {},
        "statistic": {
          "enum": [
            "mean",
            "std",
            "span",
            "slope"
          ],
          "description": "With samples: judge the mean (default), the standard deviation, the span or the slope per second of the readings."
        },
        "target": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "description": "A quantity with its unit, such as \"-253.15 °C\""
            },
            {
              "$ref": "#/$defs/instrumentTarget"
            }
          ],
          "description": "A nominal or certified value, or the reading that gives it, such as the setpoint the instrument holds. The value judged is the deviation from it."
        },
        "within": {
          "type": [
            "number",
            "string"
          ],
          "description": "With target: the absolute tolerance of the deviation."
        },
        "relative": {
          "type": [
            "number",
            "string"
          ],
          "description": "With target: the tolerance as a fraction of the target; added to within."
        }
      }
    },
    "instrumentCondition": {
      "type": "object",
      "required": [
        "id",
        "description",
        "verify",
        "accept"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$",
          "description": "Local name; the laboratory name is <device>.<id>."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "An extensible label such as equilibrium, reference, calibration, lock or operating_point."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Local names of this instrument's conditions that must hold first."
        },
        "verify": {
          "$ref": "#/$defs/instrumentStep"
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1,
          "description": "Readings one verification takes; a tolerance judges their statistic."
        },
        "interval": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Seconds between samples."
        },
        "accept": {
          "$ref": "#/$defs/instrumentTolerance"
        },
        "usable": {
          "$ref": "#/$defs/instrumentTolerance"
        },
        "reference": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "correct": {
          "description": "Operations of this instrument that restore the condition, tried in order; tune is accepted as on platforms.",
          "oneOf": [
            {
              "$ref": "#/$defs/instrumentStep"
            },
            {
              "type": "object",
              "required": [
                "tune"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          ]
        },
        "settle": {
          "type": "number",
          "minimum": 0
        },
        "valid_for": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parameter contract for a new local definition. Omit type for an unconstrained JSON value; x-* annotations do not impose constraints.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "type": {
          "enum": [
            "number",
            "integer",
            "string",
            "boolean",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "items": {
          "$ref": "#/$defs/parameter"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "limit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "examples": {
          "type": "array"
        }
      },
      "dependentSchemas": {
        "minimum": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            }
          }
        },
        "maximum": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "number",
                "integer"
              ]
            }
          }
        },
        "items": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        },
        "minItems": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        },
        "maxItems": {
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "array"
            }
          }
        }
      }
    },
    "instrumentTarget": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "description": "The reading of this instrument that gives a target, such as its setpoint; device may be omitted.",
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "value": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Path into its result; default [\"value\"]."
        }
      }
    }
  }
}
