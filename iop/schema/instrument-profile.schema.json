{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Instrument Model Description",
  "type": "object",
  "required": [
    "id",
    "match",
    "config"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "driver": {
      "enum": [
        "scpi",
        "modbus",
        "http"
      ],
      "default": "scpi",
      "description": "Driver whose operations the description holds. SDK drivers describe their own operations."
    },
    "match": {
      "type": "object",
      "required": [
        "manufacturer",
        "model"
      ],
      "properties": {
        "manufacturer": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "serial_number": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "firmware": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "config": {
      "type": "object",
      "required": [
        "operations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object"
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "write": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "object"
              },
              "data": {
                "type": "object",
                "required": [
                  "parameter",
                  "dtype"
                ],
                "description": "Binary block sent after the write command; see docs/runtime/drivers.md",
                "properties": {
                  "parameter": {
                    "type": "string"
                  },
                  "dtype": {
                    "enum": [
                      "int8",
                      "uint8",
                      "int16",
                      "uint16",
                      "int32",
                      "uint32",
                      "int64",
                      "uint64",
                      "float32",
                      "float64"
                    ]
                  },
                  "byte_order": {
                    "enum": [
                      "little",
                      "big"
                    ]
                  }
                }
              },
              "effect": {
                "enum": [
                  "observe",
                  "change"
                ]
              },
              "completion": {
                "type": "object"
              },
              "function": {
                "enum": [
                  "read_holding_registers",
                  "read_input_registers",
                  "read_coils",
                  "read_discrete_inputs",
                  "write_register",
                  "write_registers",
                  "write_coil"
                ]
              },
              "arguments": {
                "type": "object"
              },
              "value_parameter": {
                "type": "string"
              },
              "scale": {
                "type": "number"
              },
              "offset": {
                "type": "number"
              },
              "signed": {
                "type": "boolean"
              },
              "unit": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "body": {},
              "result_path": {
                "type": "array"
              }
            },
            "description": "scpi: exactly one of query or write. modbus: function, with fixed arguments, scale, offset, signed, unit and value_parameter. http: path, method, query, body, result_path and unit."
          }
        }
      },
      "additionalProperties": false
    }
  }
}
