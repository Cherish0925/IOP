{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Standard or Workflow Operation",
  "description": "A reusable composition of operations saved in the laboratory. Basic Operations are the operations of registered devices. Give steps and result, or, for a Workflow Operation that decides from results, send program files with the definition.",
  "type": "object",
  "required": [
    "id",
    "layer",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "layer": {
      "enum": [
        "standard",
        "workflow"
      ],
      "description": "standard: a reusable method built from Basic and Standard Operations. workflow: an organization of methods across devices; it may use all three."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the operation achieves"
    },
    "conditions": {
      "type": "string",
      "description": "When the result has its stated meaning"
    },
    "parameters": {
      "type": "object",
      "description": "name -> {type, minimum, maximum, enum, default, required, unit}"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "description": "Device whose operation is called (a Basic Operation). Omit it to use a saved Standard or Workflow Operation named by operation."
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "after": {
            "$ref": "#/$defs/strings"
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "step"
              ],
              "properties": {
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "description": "Run in the order written; after: [] starts a parallel branch. \"${name}\" in arguments or device inserts a parameter."
    },
    "result": {
      "type": "object",
      "description": "name -> {step, path}: the values the operation returns",
      "additionalProperties": {
        "type": "object",
        "required": [
          "step"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "readOnly": true,
      "description": "Set by the Runtime from the program files: command, files, sha256 and bytes. The program reads IOP_PARAMETERS_JSON and saves its result."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
